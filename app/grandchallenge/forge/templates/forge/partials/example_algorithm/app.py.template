"""
Example algorithm inference server for Grand Challenge.

Grand Challenge runs your algorithm as an HTTP server with two endpoints:

  GET  /health  — Called repeatedly after the container starts. Once this
                  returns HTTP 200, Grand Challenge considers the server ready.
  POST /invoke  — Called once per case. Your algorithm should read its input
                  from /input, write its output to /output, and return HTTP 201.

The lifecycle on Grand Challenge is:

  1. Container starts → your server boots and loads the model
  2. /health is polled until it returns 200 (timeout: ~5 minutes)
  3. For each case:
       a. Inputs are placed at /input (previous inputs/outputs are cleared)
       b. POST /invoke is called
       c. Your code reads /input, processes, writes to /output, returns 201
  4. Container is kept warm for a while in case more cases arrive

Key points:
  - Load your model during startup (in the lifespan context), not during
    /invoke. Each /invoke call has its own timeout, and spending that time
    loading a model will cause failures.
  - The server must listen on port 4743.
  - /health must NOT redirect (302 is treated as a failure).
  - /invoke must return exactly 201 on success. Any other status is a failure.
  - Your container will have no internet access at runtime.

Any implementation will do — FastAPI is used here as an example. The only
requirements are the two endpoints and the LABEL in the Dockerfile.
"""
from contextlib import asynccontextmanager
from pathlib import Path

from fastapi import FastAPI, Response, status
import torch
import uvicorn

import inference


from uvicorn.config import LOGGING_CONFIG


def _show_torch_cuda_info():
    print("=+=" * 10)
    print("Collecting Torch CUDA information")
    print(f"Torch CUDA is available: {(available := torch.cuda.is_available())}")
    if available:
        print(f"\tnumber of devices: {torch.cuda.device_count()}")
        print(f"\tcurrent device: { (current_device := torch.cuda.current_device())}")
        print(f"\tproperties: {torch.cuda.get_device_properties(current_device)}")
    print("=+=" * 10)


def init_model():
    """Load and return your model.

    This is called once during server startup (before /health returns 200).
    The model is then reused across all /invoke calls — so load it here,
    not inside the invoke handler.
    """
    _show_torch_cuda_info()

    # Example how to set torch to use the GPU (if available)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")
    model = torch.nn.Linear(10, 1).to(device)

    # Your model will be extracted to `model_dir` at runtime on Grand Challenge.
    # When testing locally, the local `./model` directory is mounted here.
    # When you're ready for testing on Grand Challenge, upload it as a tarball
    # via Your algorithm > Models on Grand Challenge.
    model_dir = Path("/opt/ml/model")
    with open(
        model_dir / "a_tarball_subdirectory" / "some_tarball_resource.txt", "r"
    ) as f:
        print(f.read())

    return model


MODELS = {}


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Server lifespan: load the model at startup, release at shutdown.

    Everything before `yield` runs before the server accepts requests.
    This is where you should do expensive initialization (loading weights,
    warming up the GPU, etc.) so that /invoke can run as fast as possible.
    """
    MODELS["answer_to_everything"] = init_model()
    yield
    MODELS.clear()


app = FastAPI(lifespan=lifespan)


@app.get("/health")
async def health():
    """Health check endpoint.

    Grand Challenge polls this after the container starts.
    Return 200 when the model is loaded and the server is ready to handle /invoke calls.
    Redirect responses will not be followed and will raise an exception.
    Any other response will be ignored.
    """
    try:
        _ = MODELS["answer_to_everything"]
        return Response(status_code=status.HTTP_200_OK)
    except KeyError:
        return Response(status_code=status.HTTP_404_NOT_FOUND)


@app.post("/invoke")
async def invoke():
    """Invoke endpoint — called once per case.

    When this is called, the case's input files are available at /input.
    Read them, run inference, write results to /output, and return 201.

    This may be called multiple times (once per case) without the container
    restarting. Each call gets fresh /input and /output directories.
    """
    model = MODELS["answer_to_everything"]
    inference.run(model)
    return Response(status_code=status.HTTP_201_CREATED)


if __name__ == "__main__":
    # Grand Challenge expects the server on port 4743 — do not change this.
    log_config = LOGGING_CONFIG.copy()
    log_config["handlers"]["default"]["stream"] = "ext://sys.stdout"
    uvicorn.run(app, host="0.0.0.0", port=4743, log_config=log_config)
