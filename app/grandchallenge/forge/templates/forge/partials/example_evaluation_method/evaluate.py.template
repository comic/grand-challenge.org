        {% if socket.has_example_value %}
            {% if socket.example_value|is_string %}
                "{{ socket.example_value }}"
            {% else %}
                {{ socket.example_value }}
            {% endif %}
        {% elif socket.is_image_kind %} numpy.eye(4, 2)
        {% elif socket.is_json_kind %} {"content": "should match the required format"}
        {% elif socket.is_file_kind %} "content: should match the required format"
        {% endif %}
        {% endspaceless %}
    {% endfor %}

    # Save your output
    {% for socket in object.evaluation_additional_outputs  %}
    {% if socket.is_panimg_kind %}
    write_array_as_image_file(
        location=OUTPUT_DIRECTORY / "{{ socket.relative_path }}",
        array=output_{{ socket.slug|dash_to_underscore }},
    )
    {% elif socket.is_dicom_image_kind %}
    write_array_as_dicom_image_set(
        location=OUTPUT_DIRECTORY / "{{ socket.relative_path }}",
        array=output_{{ socket.slug|dash_to_underscore }},
    )
    {% elif socket.is_json_kind %}
    write_json_file(
        location=OUTPUT_DIRECTORY / "{{ socket.relative_path }}",
        content=output_{{ socket.slug|dash_to_underscore }}
    )
    {% elif socket.is_file_kind %}
    write_file(
        location=OUTPUT_DIRECTORY / "{{ socket.relative_path }}",
        content=output_{{ socket.slug|dash_to_underscore }}
    )
    {% endif %}
    {% endfor %}

    {% endif %}

    return 0

def process(job):
    # The key is a tuple of the slugs of the input sockets
    interface_key = get_interface_key(job)

    # Lookup the handler for this particular set of sockets (i.e. the interface)
    handler = {
    {% for interface_name, interface_key in object.algorithm_interface_names|zip:object.algorithm_interface_keys %}
    {{ interface_key }} : process_{{ interface_name }},
    {% endfor %}
    }[interface_key]

    {% if object.evaluation_additional_inputs %}
    # Read additional inputs from the submission

    {% for socket in object.evaluation_additional_inputs %}
    {% if socket.is_panimg_kind %}
    submission_{{ socket.slug|dash_to_underscore }} = load_image_file_as_array(
        location=INPUT_DIRECTORY / "{{ socket.relative_path }}",
    )
    {% elif socket.is_dicom_image_kind %}
    submission_{{ socket.slug|dash_to_underscore }} = load_dicom_image_set_as_array(
        location=INPUT_DIRECTORY / "{{ socket.relative_path }}",
    )
    {% elif socket.is_json_kind %}
    submission_{{ socket.slug|dash_to_underscore }} = load_json_file(
        location=INPUT_DIRECTORY / "{{ socket.relative_path }}",
    )
    {% elif socket.is_file_kind %}
    submission_{{ socket.slug|dash_to_underscore }} = load_file(
        location=INPUT_DIRECTORY / "{{ socket.relative_path }}",
    )
    {% endif %}
    {% endfor %}
    # Finally, call the handler
    return handler(
        job,
    {% for socket in object.evaluation_additional_inputs %}
       submission_{{ socket.slug|dash_to_underscore }},
    {% endfor %}
    )
    {% else %}
    # Call the handler
    return handler(job)
    {% endif %}


